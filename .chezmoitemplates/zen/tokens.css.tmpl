/* Nord Dark — {{ .profile.name }}. Palette and roles: .chezmoidata/zen.yaml. */
{{ range $name, $color := .zen.palette -}}
--{{ $name }}: {{ $color }};
{{ end }}
--nord-font-sans: {{ .zen.fonts.sans | quote }}, "Geist Sans", sans-serif;
--nord-font-mono: {{ .zen.fonts.mono | quote }}, monospace;
--nord-font-display: {{ .zen.fonts.display | quote }}, var(--nord-font-sans);
--nord-profile-accent: var(--{{ .profile.accent }});
--nord-base: var(--nord1);
--nord-surface: var(--nord2);
--nord-raised: var(--nord3);
--nord-text: var(--nord5);
--nord-secondary-text: var(--nord4);
--nord-heading: var(--nord6);
--nord-selection: color-mix(in srgb, var(--nord10) 45%, var(--nord1));
--nord-primary-button: color-mix(in srgb, var(--nord10) 35%, var(--nord1));
--nord-primary-button-hover: color-mix(in srgb, var(--nord10) 35%, var(--nord2));
--nord-shadow: 0 8px 28px color-mix(in srgb, var(--nord0) 65%, transparent);

color-scheme: dark !important;
accent-color: var(--nord8) !important;
font-family: var(--nord-font-sans) !important;

/* Zen's generated colors, including the new token-based UI. */
--zen-primary-color: var(--nord8) !important;
--zen-branding-dark: var(--nord-base) !important;
--zen-branding-paper: var(--nord6) !important;
--zen-branding-bg: var(--nord-base) !important;
--zen-branding-bg-reverse: var(--nord6) !important;
--zen-colors-primary: var(--nord-primary-button) !important;
--zen-colors-secondary: var(--nord-surface) !important;
--zen-colors-tertiary: var(--nord-base) !important;
--zen-colors-hover-bg: var(--nord-raised) !important;
--zen-colors-primary-foreground: var(--nord-text) !important;
--zen-colors-border: var(--nord3) !important;
--zen-colors-border-contrast: var(--nord9) !important;
--zen-colors-input-bg: var(--nord-surface) !important;
--zen-input-border-color: var(--nord3) !important;
--zen-main-browser-background: var(--nord-base) !important;
--zen-main-browser-background-toolbar: var(--nord-base) !important;
--zen-themed-toolbar-bg: var(--nord-base) !important;
--zen-themed-toolbar-bg-transparent: var(--nord-base) !important;
--zen-dialog-background: var(--nord-surface) !important;
--zen-urlbar-background: var(--nord-surface) !important;
--zen-urlbar-background-base: var(--nord-surface) !important;
--zen-urlbar-background-transparent: var(--nord-surface) !important;
--zen-toolbar-element-bg: var(--nord-surface) !important;
--zen-toolbar-element-bg-hover: var(--nord-raised) !important;
--zen-sidebar-themed-icon-fill: var(--nord7) !important;
--zen-sidebar-notification-bg: var(--nord-surface) !important;
--zen-big-shadow: var(--nord-shadow) !important;

/* Firefox chrome aliases (old and current names coexist across versions). */
--lwt-accent-color: var(--nord-base) !important;
--lwt-text-color: var(--nord-text) !important;
--lwt-sidebar-background-color: var(--nord-base) !important;
--lwt-sidebar-text-color: var(--nord-text) !important;
--toolbar-bgcolor: var(--nord-base) !important;
--toolbar-background-color: var(--nord-base) !important;
--toolbar-color: var(--nord-text) !important;
--toolbar-text-color: var(--nord-text) !important;
--toolbox-textcolor: var(--nord-text) !important;
--toolbox-textcolor-inactive: var(--nord-secondary-text) !important;
--toolbar-field-background-color: var(--nord-surface) !important;
--toolbar-field-focus-background-color: var(--nord-surface) !important;
--toolbar-field-color: var(--nord-text) !important;
--toolbar-field-focus-color: var(--nord-heading) !important;
--toolbar-field-border-color: var(--nord3) !important;
--toolbar-field-focus-border-color: var(--nord8) !important;
--toolbarbutton-icon-fill: var(--nord7) !important;
--toolbarbutton-icon-fill-attention: var(--nord8) !important;
--toolbarbutton-hover-background: var(--nord-raised) !important;
--toolbarbutton-active-background: var(--nord-selection) !important;
--toolbarbutton-background-color-hover: var(--nord-raised) !important;
--toolbarbutton-background-color-active: var(--nord-selection) !important;
--tab-background-color-hover: var(--nord-surface) !important;
--tab-hover-background-color: var(--nord-surface) !important;
--tab-background-color-selected: var(--nord-raised) !important;
--tab-selected-bgcolor: var(--nord-raised) !important;
--tab-selected-textcolor: var(--nord-heading) !important;
--tab-selected-color: var(--nord-heading) !important;
--tab-text-color-selected: var(--nord-heading) !important;
--tab-text-color: var(--nord-text) !important;
--tab-selected-color-scheme: dark !important;
--urlbar-box-bgcolor: var(--nord-surface) !important;
--urlbar-box-hover-bgcolor: var(--nord-raised) !important;
--urlbarView-highlight-background: var(--nord-raised) !important;
--urlbarView-highlight-color: var(--nord-heading) !important;
--urlbarView-action-color: var(--nord-secondary-text) !important;
--urlbarView-url-color: var(--nord-secondary-text) !important;
--arrowpanel-background: var(--nord-surface) !important;
--arrowpanel-color: var(--nord-text) !important;
--arrowpanel-border-color: var(--nord3) !important;
--arrowpanel-dimmed: var(--nord-raised) !important;
--arrowpanel-dimmed-further: var(--nord-selection) !important;
--panel-separator-color: var(--nord3) !important;
--panel-separator-zap-gradient: none !important;
--sidebar-background-color: var(--nord-base) !important;
--sidebar-text-color: var(--nord-text) !important;
--sidebar-border-color: var(--nord3) !important;
--input-background-color: var(--nord-base) !important;
--input-bgcolor: var(--nord-base) !important;
--input-text-background-color: var(--nord-base) !important;
--input-color: var(--nord-text) !important;
--input-border-color: var(--nord3) !important;
--focus-outline-color: var(--nord8) !important;
--attention-dot-color: var(--nord8) !important;

/* Firefox design-system controls and built-in pages. */
--background-color-canvas: var(--nord-base) !important;
--background-color-box: var(--nord-surface) !important;
--background-color-subtle: var(--nord-surface) !important;
--text-color: var(--nord-text) !important;
--text-color-deemphasized: var(--nord-secondary-text) !important;
--text-color-disabled: var(--nord-secondary-text) !important;
--border-color: var(--nord3) !important;
--border-color-deemphasized: var(--nord3) !important;
--color-accent-primary: var(--nord8) !important;
--color-accent-primary-hover: var(--nord7) !important;
--color-accent-primary-active: var(--nord9) !important;
--color-accent-primary-contrast: var(--nord1) !important;
--button-background-color: var(--nord-surface) !important;
--button-background-color-hover: var(--nord-raised) !important;
--button-background-color-active: var(--nord-selection) !important;
--button-background-color-primary: var(--nord-primary-button) !important;
--button-background-color-primary-hover: var(--nord-primary-button-hover) !important;
--button-background-color-primary-active: var(--nord-selection) !important;
--button-primary-hover-bgcolor: var(--nord-primary-button-hover) !important;
