--in-content-box-info-background: var(--nord-surface) !important;
--in-content-box-border-color: var(--nord3) !important;
--in-content-border-color: var(--nord3) !important;
--in-content-border-hover: var(--nord8) !important;
--in-content-border-focus: var(--nord8) !important;
--in-content-button-background: var(--nord-surface) !important;
--in-content-button-background-hover: var(--nord-raised) !important;
--in-content-button-background-active: var(--nord-selection) !important;
--in-content-button-text-color: var(--nord-text) !important;
--in-content-primary-button-background: var(--nord-primary-button) !important;
--in-content-primary-button-background-hover: var(--nord-primary-button-hover) !important;
--in-content-primary-button-background-active: var(--nord-selection) !important;
--in-content-primary-button-text-color: var(--nord-heading) !important;
--in-content-primary-button-border-color: var(--nord9) !important;
--in-content-item-selected: var(--nord-selection) !important;
