// Nord Dark. Generated by chezmoi; shared across all three profiles.
// toolbar-theme/content-theme are derived Firefox state, not persistent inputs.
user_pref("browser.download.dir", {{ joinPath .chezmoi.homeDir .zen.download_dir | toJson }});
{{ range $key, $value := .zen.preferences -}}
user_pref({{ $key | toJson }}, {{ $value | toJson }});
{{ end -}}
{{ range $key, $color := .zen.palette_preferences -}}
user_pref({{ $key | toJson }}, {{ index $.zen.palette $color | toJson }});
{{ end -}}
