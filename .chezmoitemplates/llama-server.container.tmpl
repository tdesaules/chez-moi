[Unit]
Description=Llama.cpp — {{ .llama.name }}
After=network-online.target
Wants=network-online.target
Wants={{ .llama.tray_service }}
ConditionPathExists={{ .chezmoi.homeDir }}/{{ .llama.models_dir }}/{{ .llama.model }}
{{ if hasKey .llama "projector" -}}
ConditionPathExists={{ .chezmoi.homeDir }}/{{ .llama.models_dir }}/{{ .llama.projector }}
{{ end }}

[Container]
Image={{ .llama.image }}
ContainerName={{ .llama.service | trimSuffix ".service" }}
AddDevice=/dev/dri
GroupAdd=keep-groups
SecurityLabelDisable=true
PublishPort=127.0.0.1:{{ .llama.port }}:8080
Volume={{ .chezmoi.homeDir }}/{{ .llama.models_dir }}:/models:ro
Exec=--model /models/{{ .llama.model }}{{ if hasKey .llama "projector" }} --mmproj /models/{{ .llama.projector }}{{ end }} --alias {{ .llama.alias }} --host 0.0.0.0 --port 8080 --ctx-size {{ mul .llama.context_per_slot .llama.parallel }} --parallel {{ .llama.parallel }} --kv-unified-per-slot {{ .llama.context_per_slot }} --fit off --n-gpu-layers 99{{ if hasKey .llama "cache_type" }} --cache-type-k {{ .llama.cache_type }} --cache-type-v {{ .llama.cache_type }} --flash-attn on{{ end }} --jinja --temp 0.6 --top-p 0.95 --top-k 20

[Service]
TimeoutStartSec={{ .llama.startup_timeout }}
