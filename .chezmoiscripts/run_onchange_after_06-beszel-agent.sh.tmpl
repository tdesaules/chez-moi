#!/bin/bash
{{- if and .is_systemd .is_fedora }}
set -euo pipefail
umask 077
{{ include ".chezmoitemplates/functions.tmpl" }}

# {{ include "dot_config/containers/systemd/private_beszel.container.tmpl" | sha256sum }}
# {{ include "dot_config/containers/systemd/beszel-agent.container.tmpl" | sha256sum }}
# {{ include ".chezmoidata/beszel.yaml" | sha256sum }}
# Credential rotation must retrigger synchronization, without embedding shell literals.
# {{ gopass "perso/web/beszel.desaules.in/thibault@desaules.me" | sha256sum }}
# {{ output "gopass" "show" "perso/web/beszel.desaules.in/thibault@desaules.me" "username" | sha256sum }}

BESZEL_HUB="http://localhost:{{ .beszel.port }}"
GOPASS="{{ .chezmoi.homeDir }}/.local/share/mise/shims/gopass"
BESZEL_EMAIL=$("$GOPASS" show "perso/web/beszel.desaules.in/thibault@desaules.me" username)
BESZEL_PASSWORD=$("$GOPASS" show -o "perso/web/beszel.desaules.in/thibault@desaules.me")
AGENT_NAME={{ .beszel.agent_name | shellQuote }}
AGENT_ENV_FILE="{{ .chezmoi.homeDir }}/.config/beszel/agent.env"

# All requests are bounded; transport and HTTP errors remain failures.
request() {
    curl --fail-with-body --silent --show-error --connect-timeout 5 --max-time 15 "$@"
}
api() {
    request -H "Authorization: Bearer $SUPER_TOKEN" "$@"
}

ready=false
for ((i = 0; i < 30; i++)); do
    if request "$BESZEL_HUB/api/health" >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 1
done
[ "$ready" = true ] || _error_handler "beszel hub readiness; apply again to retry"

podman exec beszel /beszel superuser upsert "$BESZEL_EMAIL" "$BESZEL_PASSWORD" >/dev/null ||
    _error_handler "beszel superuser synchronization"
payload=$(jq -cn --arg identity "$BESZEL_EMAIL" --arg password "$BESZEL_PASSWORD" \
    '{identity: $identity, password: $password}')
SUPER_TOKEN=$(request "$BESZEL_HUB/api/collections/_superusers/auth-with-password" \
    -H "Content-Type: application/json" --data-binary "$payload" | jq -er '.token | select(length > 0)')

# Resolve the configured account, never the first arbitrary user.
filter=$(jq -rn --arg email "$BESZEL_EMAIL" '"email=" + ($email | tojson) | @uri')
USER_ID=$(api "$BESZEL_HUB/api/collections/users/records?filter=$filter" |
    jq -er --arg email "$BESZEL_EMAIL" \
        '.items | map(select(.email == $email)) | select(length == 1) | .[0].id')
payload=$(jq -cn --arg password "$BESZEL_PASSWORD" \
    '{password: $password, passwordConfirm: $password}')
api -X PATCH "$BESZEL_HUB/api/collections/users/records/$USER_ID" \
    -H "Content-Type: application/json" --data-binary "$payload" >/dev/null
unset BESZEL_PASSWORD payload

filter=$(jq -rn --arg user "$USER_ID" '"user=" + ($user | tojson) | @uri')
TOKENS_JSON=$(api "$BESZEL_HUB/api/collections/universal_tokens/records?filter=$filter")
UNIVERSAL_TOKEN=$(jq -r '.items[0].token // empty' <<< "$TOKENS_JSON")
if [ -z "$UNIVERSAL_TOKEN" ]; then
    UNIVERSAL_TOKEN=$(openssl rand -hex 16)
    payload=$(jq -cn --arg user "$USER_ID" --arg token "$UNIVERSAL_TOKEN" \
        '{user: $user, token: $token}')
    api "$BESZEL_HUB/api/collections/universal_tokens/records" \
        -H "Content-Type: application/json" --data-binary "$payload" >/dev/null
fi

HUB_DATA_VOLUME=$(podman volume inspect {{ .beszel.data_volume | shellQuote }} --format '{{ "{{ .Mountpoint }}" }}')
AGENT_KEY=$(ssh-keygen -y -f "$HUB_DATA_VOLUME/id_ed25519")
mkdir -p "$(dirname "$AGENT_ENV_FILE")"
temporary=$(mktemp "$AGENT_ENV_FILE.XXXXXX")
trap 'rm -f "$temporary"' EXIT
cat > "$temporary" <<EOF
TOKEN=$UNIVERSAL_TOKEN
KEY=$AGENT_KEY
HUB_URL=$BESZEL_HUB
SYSTEM_NAME=$AGENT_NAME
DISABLE_SSH=true
DOCKER_HOST=unix:///run/podman/podman.sock
EOF
mv "$temporary" "$AGENT_ENV_FILE"

# Restart even if an old agent is online: its credentials may have changed.
WANTS_DIR="{{ .chezmoi.homeDir }}/{{ .systemd.user_dir }}/default.target.wants"
mkdir -p "$WANTS_DIR"
ln -sf "/run/user/$(id -u)/systemd/generator/beszel-agent.service" "$WANTS_DIR/beszel-agent.service"
systemctl --user restart beszel-agent.service
filter=$(jq -rn --arg name "$AGENT_NAME" '"name=" + ($name | tojson) | @uri')
for ((i = 0; i < 30; i++)); do
    if api "$BESZEL_HUB/api/collections/systems/records?filter=$filter" |
        jq -e --arg name "$AGENT_NAME" \
            '.items | any(.name == $name and (.status == "up" or .status == "online"))' >/dev/null; then
        _log "success" "beszel agent registered and up"
        exit 0
    fi
    sleep 2
done
_error_handler "beszel agent registration; apply again to retry"
{{- end }}
