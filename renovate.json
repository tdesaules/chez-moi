{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.chezmoidata\\/(apps|plugins)\\.yaml$/"],
      "matchStrings": ["# renovate: depName=(?<depName>\\S+)\\s+[a-z_]+: \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["storytold/lightcraft", "storytold/pdfcraft", "storytold/vectorcraft"],
      "extractVersion": "^v(?<version>.*)$"
    },
    {
      "matchPackageNames": ["storytold/lightcraft", "storytold/pdfcraft", "storytold/vectorcraft", "kilianvivien/DarkSlide"],
      "groupName": "craft-distrobox apps"
    },
    {
      "matchPackageNames": ["tdesaules/gopass-dms", "tdesaules/pinentry-dms"],
      "groupName": "DMS plugins"
    }
  ]
}
