FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
COPY main.go .
RUN CGO_ENABLED=0 go build -trimpath -o /entrypoint main.go
# Provenance: catalogue 1.6.3 maintenance/update-dependencies/Containerfile
# delivers quay.io/fedora/fedora:45 with Renovate 44.181.6 and its runtime.
FROM ghcr.io/tdesaules/github-actions/maintenance-update-dependencies@sha256:129fa905223f88452c1e17ba665b36872cdc2c5affa4dc3d178145e8f6c1577e
COPY --from=build /entrypoint /validate-renovate
WORKDIR /github/workspace
ENTRYPOINT ["/validate-renovate"]
