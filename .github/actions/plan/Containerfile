FROM docker.io/library/golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
COPY main.go .
RUN CGO_ENABLED=0 go build -trimpath -o /entrypoint main.go
FROM docker.io/orhunp/git-cliff:2.14.2@sha256:1e696a381a1b0366bb6ccbb6bd4e50e73473fda88eab3a757b95e0d0d66c9531 AS cliff
FROM quay.io/fedora/fedora:45@sha256:f236063d5a7a15e76ff034f2be5fa6f7a8922fcb655093ad972a1f196b14a007
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False python3 git libgcc ca-certificates && dnf clean all
COPY --from=cliff /usr/local/bin/git-cliff /usr/local/bin/git-cliff
COPY --from=build /entrypoint /entrypoint
RUN git-cliff --version
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
