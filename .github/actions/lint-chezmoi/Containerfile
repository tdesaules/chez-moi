FROM docker.io/library/golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
WORKDIR /src
COPY main.go .
RUN CGO_ENABLED=0 go build -trimpath -o /entrypoint main.go
FROM quay.io/fedora/fedora:45@sha256:b174cd5906c712f59a675cc85ea2ca8ff3bcf3643f1a1f3bc4e14dc28bcf1872 AS nushell
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False curl tar gzip && dnf clean all
RUN case "$(uname -m)" in \
      x86_64) checksum=33b907da92b0e80bd10fea9fa0e8a1624cabfebd89ee2568e365da3c492ffc68 ;; \
      aarch64) checksum=e1a4ff6baa2d7976bb51eccfd44295a871cdd0bc69890a5e9b3b83a0abd9acb1 ;; \
      *) exit 1 ;; \
    esac \
    && curl --fail --location --retry 3 "https://github.com/nushell/nushell/releases/download/0.117.0/nu-0.117.0-$(uname -m)-unknown-linux-gnu.tar.gz" -o /tmp/nu.tar.gz \
    && echo "$checksum  /tmp/nu.tar.gz" | sha256sum --check --strict \
    && mkdir /opt/nu && tar -xzf /tmp/nu.tar.gz --strip-components=1 -C /opt/nu
FROM quay.io/fedora/fedora:45@sha256:b174cd5906c712f59a675cc85ea2ca8ff3bcf3643f1a1f3bc4e14dc28bcf1872
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False python3 git jq chezmoi-2.73.0-1.fc45 ShellCheck-0.11.0-5.fc45 niri-26.04-2.fc45 desktop-file-utils systemd podman sudo && dnf clean all
COPY --from=nushell /opt/nu/nu /usr/local/bin/nu
COPY --from=nushell /opt/nu/LICENSE /usr/share/licenses/nushell/LICENSE
COPY --from=build /entrypoint /entrypoint
RUN nu --version && niri --version
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
