FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
COPY main.go .
RUN CGO_ENABLED=0 go build -trimpath -o /entrypoint main.go
FROM quay.io/fedora/fedora:45@sha256:b174cd5906c712f59a675cc85ea2ca8ff3bcf3643f1a1f3bc4e14dc28bcf1872
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False python3 git ca-certificates && dnf clean all
COPY --from=build /entrypoint /entrypoint
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
