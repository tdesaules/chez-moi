#!/usr/bin/python3
"""StatusNotifierItem + DBusMenu for Dank; uses Fedora's system PyGObject."""
import signal
import subprocess

import gi

gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, Gio, GLib

NAME = {{ .llama.name | toJson }}
ICON = "{{ .chezmoi.homeDir }}/.local/share/icons/{{ .llama.icon }}.svg"
SERVICE = {{ .llama.service | toJson }}
ADDRESS = "127.0.0.1:{{ .llama.port }}"
URL = "http://" + ADDRESS
SNI = "org.kde.StatusNotifierItem"
MENU = "com.canonical.dbusmenu"
WATCHER = "org.kde.StatusNotifierWatcher"

XML = """<node>
<interface name="org.kde.StatusNotifierItem">
 <property name="Category" type="s" access="read"/>
 <property name="Id" type="s" access="read"/>
 <property name="Title" type="s" access="read"/>
 <property name="Status" type="s" access="read"/>
 <property name="WindowId" type="u" access="read"/>
 <property name="IconName" type="s" access="read"/>
 <property name="IconPixmap" type="a(iiay)" access="read"/>
 <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
 <property name="ItemIsMenu" type="b" access="read"/>
 <property name="Menu" type="o" access="read"/>
 <method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
 <method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
 <method name="ContextMenu"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
 <method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
 <signal name="NewToolTip"/>
</interface>
<interface name="com.canonical.dbusmenu">
 <property name="Version" type="u" access="read"/>
 <property name="TextDirection" type="s" access="read"/>
 <property name="Status" type="s" access="read"/>
 <property name="IconThemePath" type="as" access="read"/>
 <method name="GetLayout"><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="as" direction="in"/><arg type="u" direction="out"/><arg type="(ia{sv}av)" direction="out"/></method>
 <method name="GetGroupProperties"><arg type="ai" direction="in"/><arg type="as" direction="in"/><arg type="a(ia{sv})" direction="out"/></method>
 <method name="GetProperty"><arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="out"/></method>
 <method name="Event"><arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="in"/><arg type="u" direction="in"/></method>
 <method name="EventGroup"><arg type="a(isvu)" direction="in"/><arg type="ai" direction="out"/></method>
 <method name="AboutToShow"><arg type="i" direction="in"/><arg type="b" direction="out"/></method>
 <method name="AboutToShowGroup"><arg type="ai" direction="in"/><arg type="ai" direction="out"/><arg type="ai" direction="out"/></method>
 <signal name="LayoutUpdated"><arg type="u"/><arg type="i"/></signal>
</interface></node>"""


class Tray:
    def __init__(self):
        self.revision = 1
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(ICON, 64, 64, True).add_alpha(False, 0, 0, 0)
        pixels = pixbuf.get_pixels()
        argb = bytearray()
        for y in range(pixbuf.get_height()):
            for x in range(pixbuf.get_width()):
                i = y * pixbuf.get_rowstride() + x * 4
                argb.extend((pixels[i + 3], pixels[i], pixels[i + 1], pixels[i + 2]))
        self.pixmaps = [(pixbuf.get_width(), pixbuf.get_height(), bytes(argb))]
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        info = Gio.DBusNodeInfo.new_for_xml(XML)
        for path, interface in [("/StatusNotifierItem", SNI), ("/Menu", MENU)]:
            self.bus.register_object(path, info.lookup_interface(interface), self.call, self.property, None)
        # Re-register automatically if Dank/the watcher restarts.
        self.watch = Gio.bus_watch_name_on_connection(
            self.bus, WATCHER, Gio.BusNameWatcherFlags.NONE, self.register, lambda *args: None
        )

    def register(self, connection, name, owner):
        connection.call(
            WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierItem",
            GLib.Variant("(s)", (connection.get_unique_name(),)), None,
            Gio.DBusCallFlags.NONE, 5000, None, self.registered, None,
        )

    def registered(self, connection, result, data):
        try:
            connection.call_finish(result)
        except GLib.Error as error:
            print(f"Tray registration failed: {error}", flush=True)

    def property(self, connection, sender, path, interface, name):
        if interface == MENU:
            return {"Version": GLib.Variant("u", 3), "TextDirection": GLib.Variant("s", "ltr"),
                    "Status": GLib.Variant("s", "normal"), "IconThemePath": GLib.Variant("as", [])}[name]
        return {
            "Category": GLib.Variant("s", "ApplicationStatus"),
            "Id": GLib.Variant("s", "ornith"), "Title": GLib.Variant("s", NAME),
            "Status": GLib.Variant("s", "Active"), "WindowId": GLib.Variant("u", 0),
            "IconName": GLib.Variant("s", ICON), "IconPixmap": GLib.Variant("a(iiay)", self.pixmaps),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (ICON, self.pixmaps, NAME, ADDRESS)),
            "ItemIsMenu": GLib.Variant("b", False), "Menu": GLib.Variant("o", "/Menu"),
        }[name]

    def properties(self, item, names=()):
        if item == 0:
            props = {"children-display": GLib.Variant("s", "submenu")}
        else:
            labels = {1: ADDRESS, 2: "Open Chat", 3: "Stop"}
            props = {"label": GLib.Variant("s", labels[item]),
                     "enabled": GLib.Variant("b", item != 1), "visible": GLib.Variant("b", True)}
        return {k: v for k, v in props.items() if not names or k in names}

    def event(self, item, event):
        if event != "clicked":
            return
        if item == 2:
            subprocess.Popen(["xdg-open", URL])
        elif item == 3:
            subprocess.Popen(["systemctl", "--user", "stop", "--no-block", SERVICE])

    def call(self, connection, sender, path, interface, method, parameters, invocation):
        args = parameters.unpack()
        result = None
        try:
            if interface == SNI:
                pass  # Only the native right-click menu has actions.
            elif method == "GetLayout":
                parent, depth, names = args
                children = [GLib.Variant("(ia{sv}av)", (i, self.properties(i, names), []))
                            for i in (1, 2, 3)] if parent == 0 and depth != 0 else []
                result = GLib.Variant("(u(ia{sv}av))", (self.revision, (parent, self.properties(parent, names), children)))
            elif method == "GetGroupProperties":
                ids, names = args
                result = GLib.Variant("(a(ia{sv}))", ([(i, self.properties(i, names)) for i in (ids or [0, 1, 2, 3])],))
            elif method == "GetProperty":
                result = GLib.Variant("(v)", (self.properties(args[0])[args[1]],))
            elif method == "Event":
                self.event(args[0], args[1])
            elif method == "EventGroup":
                for item, event, data, timestamp in args[0]:
                    self.event(item, event)
                result = GLib.Variant("(ai)", ([],))
            elif method == "AboutToShow":
                result = GLib.Variant("(b)", (False,))
            elif method == "AboutToShowGroup":
                result = GLib.Variant("(aiai)", ([], []))
            invocation.return_value(result)
        except (KeyError, ValueError) as error:
            invocation.return_dbus_error("com.canonical.dbusmenu.Error", str(error))

if __name__ == "__main__":
    loop = GLib.MainLoop()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (loop.quit(), False)[1])
    tray = Tray()
    loop.run()
