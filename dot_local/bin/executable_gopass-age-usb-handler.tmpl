#!/bin/bash

{{ include ".chezmoitemplates/functions.tmpl" }}

DEVICE="/dev/disk/by-label/AGE"
MOUNT_POINT="/run/media/{{ .chezmoi.username }}/AGE"
IDENTITY_USB="$MOUNT_POINT/identities"
IDENTITY_LOCAL="{{ .chezmoi.homeDir }}/.config/gopass/age/identities"
GOPASS="{{ .chezmoi.homeDir }}/.local/share/mise/shims/gopass"
SELFHEAL="{{ .chezmoi.homeDir }}/.local/bin/gopass-age-selfheal"
AGENT_SOCKET="/run/user/$(id -u)/gopass/gopass-age-agent.sock"

# Purge the cached identity: lock the gopass age agent (drops the unlocked
# identity from memory) and remove the identity symlink. Idempotent.
purge_cache() {
    if [ -S "$AGENT_SOCKET" ]; then
        "$GOPASS" age agent lock 2>/dev/null || true
        _log "success" "gopass age agent locked (secrets purged)"
    else
        _log "info" "Agent not running, skipping lock"
    fi
    rm -f "$IDENTITY_LOCAL"
    _log "success" "Symlink removed"
}

case "$1" in
    start)
        if ! mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
            _log "info" "Mounting AGE USB key (read-only)..."
            /usr/bin/udisksctl mount -b "$DEVICE" --no-user-interaction 2>/dev/null
        fi
        for i in $(seq 1 10); do
            [ -f "$IDENTITY_USB" ] && break
            sleep 0.5
        done
        if [ -f "$IDENTITY_USB" ]; then
            ln -sf "$IDENTITY_USB" "$IDENTITY_LOCAL"
            _log "success" "Symlink created"
        else
            _log "error" "Identity file not found on AGE USB key"
        fi
        if ! systemctl --user is-active --quiet gopass-age-agent.service 2>/dev/null; then
            _log "info" "Starting gopass-age-agent service..."
            systemctl --user start gopass-age-agent.service
            _log "success" "gopass-age-agent service started"
        fi
        # Now that the identity is reachable, heal the agent if it is stuck
        # unlocked-but-empty (gopass <= 1.16.1 bug #3488) so the next access
        # recovers instead of prompting on every call.
        if [ -x "$SELFHEAL" ]; then
            "$SELFHEAL"
        fi
        _log "info" "Watching for AGE USB key removal..."
        # Poll the device in-process: a systemd .path unit does NOT stop a
        # already-started service when PathExists becomes false, so relying on
        # ExecStopPost for the removal cleanup is unreliable. We watch here and
        # run the cleanup ourselves, then exit (the .path unit will re-trigger
        # this service on the next insertion).
        while [ -e "$DEVICE" ]; do
            sleep 1
        done
        # Debounce transient blips (unplug/replug within 2s).
        sleep 2
        if [ -e "$DEVICE" ]; then
            _log "notice" "Device reappeared (transient blip), skipping cleanup"
            exit 0
        fi
        _log "info" "AGE USB key removed, cleaning up..."
        purge_cache
        ;;
    stop)
        # Backup path for manual `systemctl --user stop`. In normal operation
        # the start case detects removal itself and exits; this only fires via
        # ExecStopPost. Debounce + recheck to avoid acting on a transient blip.
        sleep 2
        if [ -e "$DEVICE" ]; then
            _log "notice" "Device reappeared (transient blip), skipping cleanup"
            exit 0
        fi
        _log "info" "AGE USB key removed, cleaning up..."
        purge_cache
        ;;
esac
