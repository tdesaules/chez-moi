{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/bash",
  "skills": {
    "paths": ["{{ .chezmoi.homeDir }}/.local/share/skills/opencode"]
  },
  "enabled_providers": [
    "openai",
    "opencode",
    "lemonade"
  ],
  "provider": {
    "lemonade": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade",
      "options": {
        "baseURL": "http://127.0.0.1:13305/v1",
        "apiKey": "empty"
      },
      "whitelist": [
        "user.Muse-Glimmer-30B-Q8_0"
      ],
      "models": {
        "user.Muse-Glimmer-30B-Q8_0": {
          "name": "muse-glimmer-30b"
        }
      }
    },
    "opencode": {
      "whitelist": [
        "muse-spark-1.3-contributor-free"
      ],
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "muse-spark-1.3-contributor-free"
        }
      }
    },
    "openai": {
      "whitelist": [
        "gpt-6-astra",
        "gpt-6-sol",
        "gpt-6-luna"
      ],
      "models": {
        "gpt-6-astra": {
          "name": "gpt-6-astra"
        },
        "gpt-6-sol": {
          "name": "gpt-6-sol"
        },
        "gpt-6-luna": {
          "name": "gpt-6-luna"
        }
      }
    }
  }
}
