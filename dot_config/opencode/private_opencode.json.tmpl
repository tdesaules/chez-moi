{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/bash",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-6.2-astra": {
          "name": "gpt-6.2-astra",
          "limit": {{ .opencode.openai.limit | toJson }}
        },
        "gpt-6.2-sol": {
          "name": "gpt-6.2-sol",
          "limit": {{ .opencode.openai.limit | toJson }}
        }
      }
    }
  }
}
