{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/bash",
  "skills": {
    "paths": ["{{ .chezmoi.homeDir }}/.local/share/skills/opencode"]
  },
  "enabled_providers": [
    "openai",
    "opencode"
  ],
  "provider": {
    "opencode": {
      "whitelist": [
        "muse-spark-1.3-contributor-free"
      ],
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "muse-spark-1.3-contributor-free"
        }
      }
    },
    "openai": {
      "whitelist": [
        "gpt-6-astra",
        "gpt-6.1-sol",
        "gpt-6-luna"
      ],
      "models": {
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "limit": {{ .opencode.openai.limit | toJson }}
        },
        "gpt-6.1-sol": {
          "name": "gpt-6.1-sol",
          "limit": {{ .opencode.openai.limit | toJson }}
        },
        "gpt-6-luna": {
          "name": "gpt-6-luna",
          "limit": {{ .opencode.openai.limit | toJson }}
        }
      }
    }
  }
}
