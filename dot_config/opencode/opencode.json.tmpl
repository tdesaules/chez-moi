{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/bash",
  "enabled_providers": [
    "llmgateway",
    "openai",
    "opencode",
    "lemonade"
  ],
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{{ gopass "perso/token/openrouter.ai/eb7fa3a0-eb5a-4c16-b493-0110051ae05c" | trim }}"
      },
      "whitelist": [
        "moonshotai/kimi-k3",
        "moonshotai/kimi-k2.7-code",
        "deepseek/deepseek-v4-flash",
        "z-ai/glm-5.2"
      ],
      "models": {
        "moonshotai/kimi-k3": {
          "name": "kimi-k3"
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "kimi-k2.7-code"
        },
        "deepseek/deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "z-ai/glm-5.2": {
          "name": "glm-5.2"
        }
      }
    },
    "scaleway": {
      "whitelist": [
        "glm-5.2",
        "mistral-medium-3.5-128b"
      ],
      "models": {
        "glm-5.2": {
          "name": "glm-5.2"
        },
        "mistral-medium-3.5-128b": {
          "name": "mistral-medium-3.5"
        }
      }
    },
    "zai-coding-plan": {
      "whitelist": [
        "glm-5.2"
      ],
      "models": {
        "glm-5.2": {
          "name": "glm-5.2"
        }
      }
    },
    "lemonade": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade",
      "options": {
        "baseURL": "http://127.0.0.1:13305/v1",
        "apiKey": "empty"
      },
      "whitelist": [
        "user.Muse-Glimmer-30B-Q8_0"
      ],
      "models": {
        "user.Muse-Glimmer-30B-Q8_0": {
          "name": "muse-glimmer-30b"
        }
      }
    },
    "opencode": {
      "whitelist": [
        "muse-spark-1.3-contributor"
      ],
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "muse-spark-1.3-contributor"
        }
      }
    },
    "llmgateway": {
      "whitelist": [
        "glm-5.3-flash",
        "glm-5.3",
        "glm-5.2-flash",
        "glm-5.2",
        "qwen3.8-flash",
        "qwen3.8-max",
        "muse-spark-1.3-contributor",
        "muse-spark-1.3"
      ],
      "models": {
        "glm-5.2": {
          "name": "glm-5.2"
        },
        "glm-5.2-fast": {
          "name": "glm-5.2-fast"
        },
        "glm-5.3": {
          "name": "glm-5.3"
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash"
        },
        "qwen3.8-max": {
          "name": "qwen3.8-max"
        },
        "qwen3.8-flash": {
          "name": "qwen3.8-flash"
        },
        "muse-spark-1.3-contributor": {
          "name": "muse-spark-1.3-contributor"
        },
        "muse-spark-1.3": {
          "name": "muse-spark-1.3"
        }
      }
    }
  }
}
