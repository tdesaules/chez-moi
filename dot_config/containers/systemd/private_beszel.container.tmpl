[Unit]
Description=Beszel Server
After=network.target

[Container]
Image=docker.io/henrygd/beszel:latest
ContainerName=beszel
Network=ai.network
PublishPort=0.0.0.0:{{ .beszel.port }}:{{ .beszel.port }}
Volume={{ .beszel.data_volume }}:/beszel_data
Environment=APP_URL=http://localhost:{{ .beszel.port }}
Environment={{ printf "USER_EMAIL=%s" (output "gopass" "show" "perso/web/beszel.desaules.in/thibault@desaules.me" "username" | trim) | replace "%" "%%" | quote }}
Environment={{ printf "USER_PASSWORD=%s" (gopass "perso/web/beszel.desaules.in/thibault@desaules.me" | trim) | replace "%" "%%" | quote }}
Environment={{ printf "AUTO_LOGIN=%s" (output "gopass" "show" "perso/web/beszel.desaules.in/thibault@desaules.me" "username" | trim) | replace "%" "%%" | quote }}

[Install]
WantedBy=default.target
