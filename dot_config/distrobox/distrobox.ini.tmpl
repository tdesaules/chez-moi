[craft-distrobox]
image=quay.io/fedora/fedora:{{ .chezmoi.osRelease.versionID }}
replace=true
start_now=true
entry=false
hostname="craft-distrobox"
{{ includeTemplate "distrobox/pre-init.tmpl" -}}
{{ includeTemplate "distrobox/common-hooks.tmpl" -}}
# storytold apps need GPU (wgpu) + windowing libs at runtime (RPM recommends).
additional_packages="mesa-dri-drivers mesa-libGL mesa-vulkan-drivers libxkbcommon vulkan-loader libwayland-client libX11 libXcursor libXi libXrandr"
# DarkSlide ships as AppImage (amd64 only, experimental Linux support).
additional_flags="--env APPIMAGE_EXTRACT_AND_RUN=1"
init_hooks="curl --fail --location --retry 3 https://github.com/storytold/lightcraft/releases/download/v{{ .craft.lightcraft }}/lightcraft-{{ .craft.lightcraft }}-linux-x86_64.rpm -o /tmp/lightcraft.rpm"
init_hooks="curl --fail --location --retry 3 https://github.com/storytold/pdfcraft/releases/download/v{{ .craft.pdfcraft }}/pdfcraft-{{ .craft.pdfcraft }}-linux-x86_64.rpm -o /tmp/pdfcraft.rpm"
init_hooks="curl --fail --location --retry 3 https://github.com/storytold/vectorcraft/releases/download/v{{ .craft.vectorcraft }}/vectorcraft-{{ .craft.vectorcraft }}-linux-x86_64.rpm -o /tmp/vectorcraft.rpm"
init_hooks="dnf --assumeyes install /tmp/lightcraft.rpm /tmp/pdfcraft.rpm /tmp/vectorcraft.rpm && rm -f /tmp/lightcraft.rpm /tmp/pdfcraft.rpm /tmp/vectorcraft.rpm"
init_hooks="curl --fail --location --retry 3 https://github.com/kilianvivien/DarkSlide/releases/download/{{ .craft.darkslide }}/DarkSlide_{{ .craft.darkslide | trimPrefix "v" }}_amd64.AppImage -o /usr/local/bin/darkslide"
init_hooks="chmod +x /usr/local/bin/darkslide"
exported_bins="/usr/local/bin/darkslide"
exported_bins_path="{{ .chezmoi.homeDir }}/.local/bin"
exported_apps="{{ .chezmoi.homeDir }}/.config/distrobox/lightcraft.desktop {{ .chezmoi.homeDir }}/.config/distrobox/pdfcraft.desktop {{ .chezmoi.homeDir }}/.config/distrobox/vectorcraft.desktop {{ .chezmoi.homeDir }}/.config/distrobox/darkslide.desktop"
{{ end -}}
