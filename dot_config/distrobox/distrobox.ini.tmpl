exported_apps="{{ .chezmoi.homeDir }}/.config/distrobox/opencode.desktop"

[orcaslicer-distrobox]
image=quay.io/fedora/fedora:{{ .atomic_version }}
replace=true
start_now=true
entry=false
hostname="orcaslicer-distrobox"
{{ includeTemplate "distrobox/pre-init.tmpl" -}}
{{ includeTemplate "distrobox/common-hooks.tmpl" -}}
additional_packages="mesa-dri-drivers mesa-libGL mesa-libGLU mesa-vulkan-drivers libglvnd-opengl webkit2gtk4.1"
additional_flags="--env APPIMAGE_EXTRACT_AND_RUN=1"
{{- $orsa_version := "v2.4.2" }}
init_hooks="curl -L https://github.com/OrcaSlicer/OrcaSlicer/releases/download/{{ $orsa_version }}/OrcaSlicer_Linux_AppImage_Ubuntu2404_V2.4.2.AppImage -o /usr/local/bin/orcaslicer"
init_hooks="chmod +x /usr/local/bin/orcaslicer"
exported_bins="/usr/local/bin/orcaslicer"
exported_bins_path="{{ .chezmoi.homeDir }}/.local/bin"
exported_apps="{{ .chezmoi.homeDir }}/.config/distrobox/orcaslicer.desktop"

