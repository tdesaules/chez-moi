{{ if eq .chezmoi.arch "amd64" -}}
[steam-distrobox]
image=quay.io/fedora/fedora:{{ .chezmoi.osRelease.versionID }}
replace=true
start_now=true
entry=false
hostname="steam-distrobox"
{{ includeTemplate "distrobox/pre-init.tmpl" -}}
