[orcaslicer-distrobox]
image=quay.io/fedora/fedora:{{ .chezmoi.osRelease.versionID }}
replace=true
start_now=true
entry=false
hostname="orcaslicer-distrobox"
{{ includeTemplate "distrobox/pre-init.tmpl" -}}
{{ includeTemplate "distrobox/common-hooks.tmpl" -}}
additional_packages="mesa-dri-drivers mesa-libGL mesa-libGLU mesa-vulkan-drivers libglvnd-opengl webkit2gtk4.1"
additional_flags="--env APPIMAGE_EXTRACT_AND_RUN=1"
# radeonsi (Mesa 26.x) segfaults on Strix Halo 8060S when rendering slice
# thumbnails (NULL deref in libc, GUI-only, CLI slices fine). zink crashes
# too (zink_kopper_acquire_submit SIGSEGV, gdb-proven). Software GL works.
# Re-test HW drivers on Mesa upgrades or OrcaSlicer > 2.4.2 (#14453).
additional_flags="--env LIBGL_ALWAYS_SOFTWARE=1"
{{- $orsa_version := .orcaslicer }}
init_hooks="curl --fail --location --retry 3 https://github.com/OrcaSlicer/OrcaSlicer/releases/download/{{ $orsa_version }}/OrcaSlicer_Linux_AppImage_Ubuntu2404_V{{ $orsa_version | trimPrefix "v" }}.AppImage -o /tmp/orcaslicer.AppImage && install -m 0755 /tmp/orcaslicer.AppImage /usr/local/bin/orcaslicer && rm /tmp/orcaslicer.AppImage"
init_hooks="chmod +x /usr/local/bin/orcaslicer"
exported_bins="/usr/local/bin/orcaslicer"
exported_bins_path="{{ .chezmoi.homeDir }}/.local/bin"
exported_apps="{{ .chezmoi.homeDir }}/.config/distrobox/orcaslicer.desktop"

