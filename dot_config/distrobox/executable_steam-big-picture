#!/usr/bin/python3
"""Run Steam in a tiled Gamescope window; fullscreen that tile while a game is open."""
import json
import os
import re
import subprocess
import sys


def niri(*args):
    return subprocess.check_output(
        ["distrobox-host-exec", "niri", "msg", "--json", *args], text=True)


def game_open(line):
    # GAMESCOPE_FOCUSABLE_WINDOWS contains triples: XID, app ID, PID.
    # Without Gamescope Steam mode the second value can be the XID; read
    # Steam's own property instead. Big Picture itself has STEAM_GAME 769.
    values = line.partition(" = ")[2].strip()
    if not values:
        return None
    seen_steam = False
    for xid in values.split(", ")[::3]:
        if not xid.isdecimal():
            continue
        prop = subprocess.run(["xprop", "-id", xid, "STEAM_GAME"],
                              capture_output=True, text=True)
        match = re.search(r" = (\d+)", prop.stdout)
        if match:
            app = int(match[1])
            if app not in (0, 769):
                return True
            seen_steam |= app == 769
    return False if seen_steam else None


def watch(pid):
    with subprocess.Popen(["xprop", "-spy", "-root", "GAMESCOPE_FOCUSABLE_WINDOWS"],
                          stdout=subprocess.PIPE, text=True) as events:
        previous = None
        for line in events.stdout:
            playing = game_open(line)
            if playing is None or playing == previous:
                continue
            windows = json.loads(niri("windows"))
            window = next((w for w in windows if w["app_id"] == "gamescope"
                           and w["pid"] == pid), None)
            if not window:
                continue
            workspace = next(w for w in json.loads(niri("workspaces"))
                             if w["id"] == window["workspace_id"])
            output = json.loads(niri("outputs"))[workspace["output"]]["logical"]
            width, height = window["layout"]["window_size"]
            fullscreen = abs(width - output["width"]) <= 2 and abs(height - output["height"]) <= 2
            if playing != fullscreen:
                niri("action", "fullscreen-window", "--id", str(window["id"]))
            previous = playing


if __name__ == "__main__":
    if sys.argv[1:2] == ["--watch"]:
        watch(int(sys.argv[2]))
    elif sys.argv[1:2] == ["--inside"]:
        # Here DISPLAY belongs to this instance, not the host XWayland server.
        subprocess.Popen([__file__, "--watch", sys.argv[2]])
        os.execvp("steam", ["steam", "-pipewire", "-bigpicture", "-forcedesktopscaling",
                            "1.0", *sys.argv[3:]])
    else:
        output = json.loads(niri("focused-output"))
        mode = output["modes"][output["current_mode"]]
        os.execvp("gamescope", ["gamescope", "--backend", "wayland", "-b",
                                "-W", "1622", "-H", "964", "-w", str(mode["width"]),
                                "-h", str(mode["height"]), "--", __file__, "--inside",
                                str(os.getpid()), *sys.argv[1:]])
