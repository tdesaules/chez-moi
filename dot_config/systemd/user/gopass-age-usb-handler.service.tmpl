[Unit]
Description=Handle AGE USB key insert/remove (mount + symlink + vault lock)
After=dms.service
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={{ .chezmoi.homeDir }}/.local/bin/gopass-age-usb-handler start
ExecStopPost={{ .chezmoi.homeDir }}/.local/bin/gopass-age-usb-handler stop
