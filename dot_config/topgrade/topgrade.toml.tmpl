[misc]
assume_yes = true
cleanup = true
no_self_update = true
disable = ["firmware","chezmoi","mise","pip3","node","pipx"]

[commands]
"Chezmoi" = "/usr/bin/chezmoi update --force --refresh-externals"
"Mise" = "/usr/bin/mise install --quiet --yes && /usr/bin/mise upgrade --quiet --yes"
"HuggingFace" = "{{ .chezmoi.homeDir }}/.local/bin/pull-hf-models"

[linux]
rpm_ostree = true

[containers]
runtime = "podman"
# Quadlet images are pulled and running services restarted by podman-auto-update.
ignored_containers = [
  "docker.io/henrygd/beszel:latest",
  "docker.io/henrygd/beszel-agent:latest",
  "ghcr.io/lemonade-sdk/lemonade-server:latest",
  "ghcr.io/open-webui/open-webui:latest",
  "ghcr.io/open-webui/open-terminal:latest",
]
